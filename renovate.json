{
   "$schema": "https://docs.renovatebot.com/renovate-schema.json",
   "extends": [
      "github>Giskard-AI/.github",
      ":pinOnlyDevDependencies"
   ],
   "lockFileMaintenance": {
      "description": "The update-lockfiles workflow already runs uv lock -U every week.",
      "enabled": false
   },
   "packageRules": [
      {
         "rangeStrategy": "widen",
         "matchManagers": [
            "pep621"
         ]
      },
      {
         "matchPackageNames": [
            "python"
         ],
         "enabled": false
      }
   ]
}